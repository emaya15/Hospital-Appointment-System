# Copy this file to ".env" and replace the placeholder values.
# NEVER commit your real .env file.

APP_NAME=Hospital Appointment System
HOSPITAL_NAME=City General Hospital

# Hospital local time zone (appointment dates/times are interpreted in this zone)
TIMEZONE=Asia/Kolkata

# MySQL connection. If your password has special characters (@ : / #), URL-encode them.
DATABASE_URL=mysql+pymysql://root:your_db_password@localhost:3306/hospital_db

# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email: "mock" only logs emails (no SMTP needed). Use "smtp" to really send.
MAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@example.com
SMTP_USE_TLS=true

# Background scheduler (reminders, no-show detection)
SCHEDULER_ENABLED=true
NO_SHOW_GRACE_MINUTES=15

# Files
UPLOAD_DIR=uploads
PDF_DIR=generated_pdfs
MAX_UPLOAD_MB=5

# Default admin: created automatically when the server starts (if it does not exist yet).
# Also usable manually: python -m scripts.create_admin
FIRST_ADMIN_EMAIL=admin@hospital.org
FIRST_ADMIN_PASSWORD=ChangeMe123
FIRST_ADMIN_NAME=System Admin
FIRST_ADMIN_PHONE=9999999999
